{
  "name": "nexus-ai-server",
  "version": "1.0.0",
  "description": "Nexus AI Backend — Express + TypeScript + Prisma",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:clean": "tsx prisma/clean-seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@prisma/client": "^6.9.0",
    "@supabase/supabase-js": "^2.49.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "bullmq": "^5.79.2",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.6.0",
    "prisma": "^6.9.0",
    "resend": "^4.8.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "yahoo-finance2": "^3.15.4",
    "zod": "^3.25.36"
